; =============================================================================
; floppydisk — PIO programs, transcribed from the MIT-licensed Adafruit_Floppy
; library (arch_rp2.cpp), which is proven on RP2040/RP2350 hardware.  The
; instruction words produced by this file are asserted in floppy.cpp to match
; Adafruit's arrays exactly (they are identical on PIO V1 / V2).
;
; NOTE: these programs intentionally do NOT use side-set.  The flux unit is
; one PIO loop iteration.  For capture the SM clock is set to
; clk_sys/(3*24e6) -> 72 MHz so the loop-rate (each jmp+pin+nop inc/dec cycle
; is exactly 3 PIO clocks) is 24 MHz.  For writing the SM clock is clk_sys/24e6
; so one count in X is also 1/24e6 s.
; =============================================================================

.program fluxread
; Count flux pulses and watch for the index pin.
;   * flux input is the 'jmp pin' (RDATA).
;   * index input is input-pin base (INDEX), captured via `in pins, 1`.
; Counts run DOWN in X while waiting for a transition; the C code negates.
; Top bit of the pushed 16-bit value is the index status, low 15 bits are the
; (inverted) count.  Two consecutive 16-bit values share a 32-bit FIFO word.
wait_one:
    jmp x--, wait_one_next  ; acts as a non-conditional decrement of X
wait_one_next:
    jmp pin, wait_zero      ; flux high -> start of pulse
    jmp wait_one            ; pin still low, keep counting
wait_zero:
    jmp x--, wait_zero_next ; acts as a non-conditional decrement of X
wait_zero_next:
    jmp pin, wait_zero [1]  ; wait for pulse high again (1-cycle delay so the
                            ; 'wait zero' loop takes the same 3 cycles as the
                            ; 'wait one' loop)
    in pins, 1              ; index status bit (MSB of this 16-bit half)
    in x, 15                ; 15 bits of inverted count
    jmp x--, wait_one       ; end-of-loop decrement, constant timing

; -----------------------------------------------------------------------------

.program fluxwrite
; Write flux transitions to WDATA.  Values are pre-decremented in software by
; the PIO overhead (OVERHEAD == 20) so that the true transition spacing equals
; the requested gap.  One count in X = 1/24e6 s.
loop_flux:
    set pins, 0             ; drive WDATA low (fixed ~15-cycle on-time)
    out x, 16               ; fetch next timing value (blocks when empty)
    nop [14]                ; +1 set, +14 delay = 15 cycles low time
    set pins, 1             ; drive WDATA high
loop_high:
    jmp x--, loop_high      ; hold high for X counts
    jmp loop_flux
; -----------------------------------------------------------------------------