;
; tft.pio - bus paralelo 8080 del SSD1963 para Raspberry Pi Pico / Pico 2
;
; side-set: bit0 = /WR, bit1 = /RD
;
; D/C y /CS NO van en el side-set: los maneja el software como GPIO normal.
; Asi (a) /CS se puede mantener bajo durante toda una rafaga de DMA, (b) el
; nivel de D/C se elige en CPU sin necesidad de un programa distinto para
; comandos y datos, y (c) una state machine detenida nunca puede meter datos
; en el panel, porque /WR solo lo baja el propio PIO.
;
; Convencion de uso de los dos programas (ver bus_pio.cpp):
;   1) la primera palabra de 32 bits que se empuja a la FIFO NO es un pixel:
;      es el numero de palabras de datos que hay que enviar,
;   2) a continuacion se empujan esas palabras de datos (por DMA o a mano),
;   3) al agotarse el contador la state machine cae en el bloque `end` y se
;      queda bloqueada en su `pull` con el bus en reposo.  Esa direccion
;      (etiqueta publica `end`) es el FINAL de la transmision: se comprueba
;      con pio_sm_get_pc(), asi que el envio termina exactamente en el ultimo
;      pixel, sin bytes de mas ni de menos y sin esperas por tiempo.
;
; El bus de 8 bits manda un byte por pulso de /WR; el de 16 bits manda dos
; bytes (un pixel RGB565) en el mismo pulso, que es como los espera el
; SSD1963.

.program tft_cmd
.side_set 2
.wrap_target
public entry:
    pull block          side 0     ; una palabra: byte de comando en bits 7..0
    mov y, osr          side 0     ; Y = 1 palabra
loop:
    jmp y--, body       side 0
public end:
    pull ifempty        side 0     ; llega una palabra nueva -> rearmar
    jmp entry           side 0
body:
    pull block          side 0
    mov isr, osr        side 0
    mov pins, isr       side 1     ; dato en el bus, /WR asserted
    nop                 side 1
    nop                 side 0     ; /WR sube -> dato capturado
    nop                 side 0
    jmp loop            side 0

; ---------------------------------------------------------------------------
; Rafaga de datos, bus de 8 bits.  4 bytes por palabra = 4/3 de pixel, asi
; que la rafaga tiene que ser multiplo de 12 bytes (4 pixeles) para no partir
; un pixel; los ultimos pixels los manda el software con GPIO directo.
; ---------------------------------------------------------------------------
.program tft_data8
.side_set 2
.wrap_target
public entry:
    pull block          side 0     ; numero de palabras de datos
    mov y, osr          side 0
loop:
    jmp y--, body       side 0
public end:
    pull ifempty        side 0
    jmp entry           side 0
body:
    pull block          side 0
    mov isr, osr        side 0
    out pins, 8         side 1     ; byte 0
    nop                 side 1
    out pins, 8         side 1     ; byte 1
    nop                 side 1
    out pins, 8         side 1     ; byte 2
    nop                 side 1
    out pins, 8         side 1     ; byte 3
    nop                 side 1     ; tSU
    nop                 side 0     ; /WR sube -> 4 bytes capturados
    nop                 side 1     ; tDH y rearme de /WR
    jmp loop            side 1

; ---------------------------------------------------------------------------
; Rafaga de datos, bus de 16 bits.  1 palabra = 2 pixeles RGB565 (16 bits
; cada uno, byte bajo primero en el bus).  `in pins, 16` solo se usa para
; desplazar el ISR y sacar el segundo pixel: lo que se lee da igual.
; ---------------------------------------------------------------------------
.program tft_data16
.side_set 2
.wrap_target
public entry:
    pull block          side 0     ; numero de palabras de datos
    mov y, osr          side 0
loop:
    jmp y--, body       side 0
public end:
    pull ifempty        side 0
    jmp entry           side 0
body:
    pull block          side 0
    mov isr, osr        side 0
    mov pins, isr       side 1     ; pixel A en los pines 0..15
    nop                 side 1
    nop                 side 0     ; /WR sube -> pixel A capturado
    nop                 side 1
    in pins, 16         side 1     ; ISR >>= 16
    mov pins, isr       side 1     ; pixel B
    nop                 side 1
    nop                 side 0     ; /WR sube -> pixel B capturado
    nop                 side 1
    jmp loop            side 1

% c-sdk {
#include "hardware/clocks.h"

// tft_program_init_config - configuracion de state machine de los dos
// programas: grupo OUT/IN de datos y side-set de /WR + /RD.
static inline pio_sm_config tft_program_init_config(pio_sm_config c, uint data_pin, uint side_pin) {
    sm_config_set_out_pins(&c, data_pin, TFT_BUS_WIDTH);
    sm_config_set_in_pin_base(&c, data_pin);
    sm_config_set_in_pin_count(&c, TFT_BUS_WIDTH);
    sm_config_set_sideset_pins(&c, side_pin);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_in_shift(&c, true, false, 32);

    float div = (float)clock_get_hz(clk_sys) / (float)TFT_PIO_MAX_CLOCK_HZ;
    if (div < 1.0f) div = 1.0f;
    sm_config_set_clkdiv(&c, div);
    return c;
}
%}
