PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "picow_doorbell"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// BLE-to-USB keyboard bridge service
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_BINARY_SENSOR

// Digital Output: WRITE (for receiving text from BLE client) + READ | NOTIFY
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_DIGITAL_OUTPUT, READ | WRITE | NOTIFY | DYNAMIC,
