// pico_kb_bridge.gatt
// Descriptor GATT compilado por el script compile_gatt.py de BTstack.
// Genera pico_kb_bridge.gatt.h con handles y UUIDs listos para usar en C++.
//
// Servicio custom "Pico KB Bridge":
//   - UUID servicio       : 0000FFE0-0000-1000-8000-00805F9B34FB
//   - Característica WRITE: 0000FFE1-0000-1000-8000-00805F9B34FB
//
// La característica solo acepta escrituras (WRITE y WRITE_WITHOUT_RESPONSE).
// No expone lectura de datos sensibles ni notificaciones, para minimizar
// superficie de ataque.

PRIMARY_SERVICE, 0000FFE0-0000-1000-8000-00805F9B34FB
CHARACTERISTIC, 0000FFE1-0000-1000-8000-00805F9B34FB, WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC,
